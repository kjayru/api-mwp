# Copy to .env and adjust. Variables already set in the environment take precedence.

NODE_ENV=development
PORT=3001

# PostgreSQL + pgvector from docker-compose.yml (host port 5433)
DATABASE_URL="postgresql://mwp:mwp@localhost:5433/mwp?schema=public"

# Origins allowed by CORS: front-mwp and admin-mwp
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# --- Auth ---
# HS256 key for access tokens: required, at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-generate-a-random-secret-of-at-least-32-chars
# Access token lifetime in seconds (default 900 = 15 min)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days (default 7)
REFRESH_TOKEN_TTL_DAYS=7

# --- Seed (npm run db:seed) ---
# Admin user created by the seed. SEED_ADMIN_PASSWORD is required and has no default
# (min. 8 characters). It is only applied when the user is created.
SEED_ADMIN_EMAIL=admin@miwebprofesional.com
SEED_ADMIN_NAME=Wile
SEED_ADMIN_PASSWORD=

# Optional: NestJS Observe telemetry. Leave empty to disable it.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Used from later phases (see docs/PLAN.md in front-mwp) ---
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
