# Copy to .env and adjust. Variables already set in the environment take precedence.

NODE_ENV=development
PORT=3001

# PostgreSQL + pgvector from docker-compose.yml (host port 5433)
DATABASE_URL="postgresql://mwp:mwp@localhost:5433/mwp?schema=public"

# Origins allowed by CORS: front-mwp and admin-mwp
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# --- Auth ---
# HS256 key for access tokens: required, at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-generate-a-random-secret-of-at-least-32-chars
# Access token lifetime in seconds (default 900 = 15 min)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days (default 7)
REFRESH_TOKEN_TTL_DAYS=7

# --- Seed (npm run db:seed) ---
# Admin user created by the seed. SEED_ADMIN_PASSWORD is required and has no default
# (min. 8 characters). It is only applied when the user is created.
SEED_ADMIN_EMAIL=admin@miwebprofesional.com
SEED_ADMIN_NAME=Wile
SEED_ADMIN_PASSWORD=

# --- Uploads (POST /api/v1/admin/uploads) ---
# Local directory for uploaded images (relative to the working directory). Served at /uploads.
UPLOADS_DIR=./uploads
# Public base URL of UPLOADS_DIR; uploads are returned as <PUBLIC_UPLOADS_URL>/<yyyy>/<mm>/<file>
PUBLIC_UPLOADS_URL=http://localhost:3001/uploads

# --- front-mwp on-demand revalidation (optional) ---
# After admin content changes the API POSTs { tags } here. Leave empty to disable.
FRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Shared secret, sent as the x-revalidate-secret header. Required (min. 32 chars) when
# FRONT_REVALIDATE_URL is set; front-mwp must have the same value. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=change-me-use-the-same-random-value-as-front-mwp

# Optional: NestJS Observe telemetry. Leave empty to disable it.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Used from later phases (see docs/PLAN.md in front-mwp) ---
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
