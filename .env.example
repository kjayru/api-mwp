# Copy to .env and adjust. Variables already set in the environment take precedence.

NODE_ENV=development
PORT=3001
# Express "trust proxy": which proxies may set X-Forwarded-For, so per-IP limits see the
# visitor IP. Default loopback (Apache on the same machine). Also: false, true, a number
# of hops, or a comma list of IPs/subnets (e.g. loopback,10.0.0.0/8).
# TRUST_PROXY=loopback

# PostgreSQL + pgvector from docker-compose.yml (host port 5433)
DATABASE_URL="postgresql://mwp:mwp@localhost:5433/mwp?schema=public"

# Origins allowed by CORS: front-mwp and admin-mwp
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# --- Auth ---
# HS256 key for access tokens: required, at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-generate-a-random-secret-of-at-least-32-chars
# Access token lifetime in seconds (default 900 = 15 min)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days (default 7)
REFRESH_TOKEN_TTL_DAYS=7

# --- Seed (npm run db:seed) ---
# Admin user created by the seed. SEED_ADMIN_PASSWORD is required and has no default
# (min. 8 characters). It is only applied when the user is created.
SEED_ADMIN_EMAIL=admin@miwebprofesional.com
SEED_ADMIN_NAME=Wile
SEED_ADMIN_PASSWORD=

# --- Uploads (POST /api/v1/admin/uploads) ---
# Local directory for uploaded images (relative to the working directory). Served at /uploads.
UPLOADS_DIR=./uploads
# Public base URL of UPLOADS_DIR; uploads are returned as <PUBLIC_UPLOADS_URL>/<yyyy>/<mm>/<file>
PUBLIC_UPLOADS_URL=http://localhost:3001/uploads

# --- front-mwp on-demand revalidation (optional) ---
# After admin content changes the API POSTs { tags } here. Leave empty to disable.
FRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Shared secret, sent as the x-revalidate-secret header. Required (min. 32 chars) when
# FRONT_REVALIDATE_URL is set; front-mwp must have the same value. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=change-me-use-the-same-random-value-as-front-mwp

# Optional: NestJS Observe telemetry. Leave empty to disable it.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- AI assistant (Phase 4, docs/API.md section 10) ---
# Claude API key. Without it the API boots, but the chat answers 503.
ANTHROPIC_API_KEY=
# Voyage AI key (knowledge base embeddings). Add a payment method in the Voyage
# dashboard: without one the account is limited to 3 requests/min and 10K tokens/min.
VOYAGE_API_KEY=
# Multilingual model with 1024-dimension vectors (voyage-3.5, voyage-3.5-lite,
# voyage-4 family). Changing it requires POST /admin/knowledge/reindex.
VOYAGE_MODEL=voyage-3.5
# Minimum cosine similarity (0-1) for a fragment to count as relevant.
KNOWLEDGE_MIN_SIMILARITY=0.5
# Google Calendar of the studio account (OAuth 2.0, offline access; scopes
# calendar.events and calendar.freebusy). All three or none: without them
# meetings are stored as REQUESTED and confirmed by email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- reCAPTCHA v3 of the contact form (docs/API.md 11.1) ---
# Secret key: when set, POST /leads requires recaptchaToken (action "contact"); unset = no check.
# The public (site) key lives in front-mwp, not here.
# RECAPTCHA_SECRET_KEY=
# Minimum score 0-1 (default 0.5)
# RECAPTCHA_MIN_SCORE=

# --- Lead notifications (Phase 5, docs/API.md 11.2) ---
# Emails SiteSettings.contactEmail on every new lead. Provider order: Brevo, then SMTP;
# with neither the API only logs "Lead notification skipped (no email provider configured)".
# Brevo REST API key (xkeysib-..., send permission). Requires MAIL_FROM, which must be a
# verified sender or on an authenticated domain in Brevo. If Brevo's "Authorized IPs" is on,
# allow the server IP.
# BREVO_API_KEY=
# MAIL_FROM=
# SMTP alternative (used only without BREVO_API_KEY). All five or none:
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# Sender, e.g. miwebprofesional <no-reply@miwebprofesional.com>
# SMTP_FROM=
# Implicit TLS: defaults to true on port 465 (STARTTLS otherwise)
# SMTP_SECURE=
# admin-mwp base URL, for the link in the email (default http://localhost:3002)
# ADMIN_URL=
